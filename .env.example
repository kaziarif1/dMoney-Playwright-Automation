# Supply an inbox you own and can access; the portal accepts Gmail addresses only.
DMONEY_TEST_GMAIL=
# Phone number of an existing Customer account from the training environment; keep any leading zero.
DMONEY_CUSTOMER_ID=
# Credentials are read at runtime and must never be committed.
DMONEY_ADMIN_EMAIL=admin@dmoney.com
DMONEY_ADMIN_PASSWORD=
DMONEY_SYSTEM_EMAIL=system@dmoney.com
DMONEY_SYSTEM_PASSWORD=
# Enter an OTP from your inbox when the app requests it (never commit the value).
DMONEY_OTP=
# Paste the one-time Agent password-reset URL here during the headed regression; never commit it.
DMONEY_AGENT_RESET_URL=
